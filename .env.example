# AI Vendor Enricher Configuration
# Copy to .env and fill in your values

# OpenAI API Key (required for AI mode; optional if using deterministic fallback only)
OPENAI_API_KEY=sk-...

# OpenAI Model (default: gpt-4-turbo)
# Options: gpt-4-turbo, gpt-4, gpt-3.5-turbo
OPENAI_MODEL=gpt-4-turbo

# LLM Provider (default: openai)
# Options: openai, anthropic (anthropic support coming soon)
AI_PROVIDER=openai

# Cache directory for enrichment results (default: .cache/ai_vendor_enricher)
AI_CACHE_DIR=.cache/ai_vendor_enricher

# Enable result caching (default: true)
# Set to "false" to disable caching (not recommended for determinism)
AI_CACHE_ENABLED=true

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional: Request timeout in seconds (default: 10)
AI_TIMEOUT=10
