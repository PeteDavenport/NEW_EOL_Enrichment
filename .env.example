# AI Vendor Enricher Configuration
# GitHub Copilot (Azure OpenAI) Integration
# Copy to .env and fill in your values
# Leave COPILOT_API_KEY blank to use deterministic-only mode (no AI calls)

# ============================================================================
# GitHub Copilot Setup (Required for AI Enrichment)
# ============================================================================

# GitHub Copilot / Azure OpenAI API key
COPILOT_API_KEY=your-azure-openai-key

# Model to use (default: gpt-4)
# Options: gpt-4, gpt-3.5-turbo (or your Azure deployment name)
COPILOT_MODEL=gpt-4

# Optional Azure OpenAI specific settings
# OPENAI_API_BASE=https://your-resource.openai.azure.com/
# OPENAI_API_VERSION=2023-05-15

# ============================================================================
# General AI Settings
# ============================================================================

# Cache directory for enrichment results (default: .cache/ai_vendor_enricher)
AI_CACHE_DIR=.cache/ai_vendor_enricher

# Enable result caching (default: true)
# Set to "false" to disable caching (not recommended for determinism)
AI_CACHE_ENABLED=true

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional: Request timeout in seconds (default: 10)
AI_TIMEOUT=10

# ============================================================================
# Deterministic Mode (no AI)
# ============================================================================
# To run in fully deterministic mode without any LLM calls:
# 1. Leave COPILOT_API_KEY blank or commented out
# 2. Run the pipeline as usual
# It will use the deterministic fallback logic for all records


